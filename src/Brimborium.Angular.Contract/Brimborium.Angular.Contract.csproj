<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Brimborium.Angular</RootNamespace>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <NoWarn>$(NoWarn);NU1510</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Json" />
        <PackageReference Include="TypedSignalR.Client.TypeScript.Analyzer">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="TypedSignalR.Client.TypeScript.Attributes" />
        <PackageReference Include="Tapper.Analyzer">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

    </ItemGroup>

    <Target Name="TypedSignalRClient">
        <Exec Command="dotnet tool run dotnet-tsrts -- --project $(MSBuildProjectFullPath) --output $(MSBuildThisFileDirectory)..\Brimborium.AngularUI\src\generated\ --eol CrLf --serializer  Json --naming-style None --enum Name" />
    </Target>
</Project>
