<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Brimborium.Angular</RootNamespace>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <UserSecretsId>Brimborium.Angular</UserSecretsId>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsPreviewNamespaces>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    </PropertyGroup>

    <PropertyGroup Condition="'$(EnableAOT)'=='true'">
        <IsAotCompatible>true</IsAotCompatible>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <TrimMode>partial</TrimMode>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release' And '$(EnableAOT)'=='true'">
        <PublishAot>true</PublishAot>
        <!--
            <IsAotCompatible>true</IsAotCompatible>
            <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
            <TrimmerSingleWarn>false</TrimmerSingleWarn>
            <TrimMode>partial</TrimMode>
        -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Injectio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Brimborium.Angular.Contract\Brimborium.Angular.Contract.csproj" />
        <ProjectReference Include="..\Brimborium.AngularUI\Brimborium.AngularUI.csproj" />
    </ItemGroup>
</Project>